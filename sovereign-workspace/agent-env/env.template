# ============================================================
# WBOS Agent Environment Templates
# Copy the appropriate section to each agent's .env file
# NEVER commit actual values — use your vault or secrets manager
# ============================================================

# ── SHARED (all agents need these) ──────────────────────────────────────────

SUPABASE_URL=https://rzedelvikosjrvthvceh.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<get from Supabase Dashboard → Settings → API>
SUPABASE_ANON_KEY=<get from Supabase Dashboard → Settings → API>
WORKSPACE_ID=WBOS-WORKSPACE-001
POLL_INTERVAL_MS=30000
SYNC_INTERVAL_MS=30000
NODE_ENV=production

# ── DeepFlex (Claude / Supervisor) ──────────────────────────────────────────
# File: agent-env/deepflex.env

AGENT_ID=AGT-DEEPFLEX-001
AGENT_NAME=deepflex
AGENT_LANE=DEEPFLEX
ANTHROPIC_API_KEY=<from vault_manifest: ANTHROPIC_API_KEY>
CLAUDE_MODEL=claude-sonnet-4-6
EVENTS_PATH=events/deepflex/
TASKS_PATH=tasks/

# ── ChatGPT / Uhura (Build Engineer) ────────────────────────────────────────
# File: agent-env/chatgpt.env

AGENT_ID=AGT-CHATGPT-001
AGENT_NAME=chatgpt
AGENT_LANE=CHATGPT
OPENAI_API_KEY=<from your OpenAI dashboard>
OPENAI_MODEL=gpt-4o
EVENTS_PATH=events/chatgpt/
TASKS_PATH=tasks/build/

# ── Gemini (Automator) ───────────────────────────────────────────────────────
# File: agent-env/gemini.env

AGENT_ID=AGT-GEMINI-001
AGENT_NAME=gemini
AGENT_LANE=GEMINI
GEMINI_API_KEY=<from Google AI Studio>
GEMINI_MODEL=gemini-1.5-pro
EVENTS_PATH=events/gemini/
TASKS_PATH=tasks/deploy/
TIKTOK_ACCESS_TOKEN=<from vault_manifest: TIKTOK_ACCESS_TOKEN>
