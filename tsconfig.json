{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "outDir": "dist",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "deepflex/*": ["deepflex/*"],
      "wealthbridge-os/*": ["wealthbridge-os/*"],
      "tax/*": ["tax/*"],
      "scripts/*": ["scripts/*"]
    }
  },
  "include": ["wealthbridge-os/**/*", "capsules/**/*", "deepflex/**/*", "tax/**/*", "scripts/**/*"],
  "exclude": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "node_modules",
    "dist",
    ".tmp-rd-test",
    "capsules/observability/**/*",
    "wealthbridge-os/orchestrator.ts",
    "wealthbridge-os/policy-engine.ts"
  ]
}
